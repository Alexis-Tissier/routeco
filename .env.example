# Backend Détour
GRAPHHOPPER_URL=http://127.0.0.1:8989

# Les données peuvent rester dans ./data ou être déplacées sur un autre disque.
# ROUTECO_DATA_DIR=/chemin/vers/routeco-data
# ROUTECO_BAN_DB=/run/media/utilisateur/OS/Users/Utilisateur/Documents/routeco-data/ban/ban.sqlite
# ROUTECO_COMMUNES_DB=/chemin/vers/routeco-data/communes.sqlite
# ROUTECO_TOLLS_DIR=/chemin/vers/routeco-data/tolls
# ROUTECO_REPORTS_DIR=/chemin/vers/routeco-data/reports

# Gestion locale
GRAPHHOPPER_RAM=8g
GRAPHHOPPER_IMPORT_RAM=10g

# Un seul calcul lourd à la fois convient à un VPS 2 OCPU. Les demandes
# identiques en cours sont automatiquement fusionnées.
ROUTECO_MAX_CONCURRENT_CALCULATIONS=1

# Les géométries GraphHopper sont réutilisées pendant 30 minutes. Modifier le
# carburant, le seuil d'économie ou le temps maximal ne relance pas le routage.
ROUTECO_ROUTING_CACHE_TTL=1800
ROUTECO_ROUTING_CACHE_ENTRIES=8

# Valeur centrale appliquée uniquement aux kilomètres payants sans tarif
# officiel. L'interface montre aussi une fourchette prudente.
ROUTECO_TOLL_ESTIMATE_EUR_PER_KM=0.105

# Futur fond cartographique auto-hébergé MapLibre/PMTiles.
# ROUTECO_MAP_STYLE_URL=http://127.0.0.1:8080/styles/routeco/style.json
